rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        request.auth != null && (
          request.auth.token.email == 'adramatv@gmail.com' ||
          request.auth.token.email == 'admin@secchance.dz' ||
          request.auth.token.email == 'khotwaride@gmail.com'
        )
      );
    }

    // Users collection: allows reading for login verification, creating for new registrations, updating profiles
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    // Care requests: creation by beneficiaries, review by specialists & admin
    match /careRequests/{requestId} {
      allow read, write: if true;
    }

    // Appointments scheduled with specialists
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Confidential specialist reports
    match /specialistReports/{reportId} {
      allow read, write: if true;
    }

    // Treatment follow-up and clinical progress
    match /treatmentFollowUps/{followUpId} {
      allow read, write: if true;
    }

    // Official partners directory
    match /partners/{partnerId} {
      allow read, write: if true;
    }

    // System notifications and alerts
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Electronic payments (Edahabia & CIB)
    match /paymentTransactions/{txId} {
      allow read, write: if true;
    }

    // Security and audit activity logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Password reset tokens
    match /passwordResets/{resetId} {
      allow read, write: if true;
    }
  }
}
