# Backend (Render)
DATABASE_URL=
PORT=10000
FRONTEND_URL=https://your-project.vercel.app
JWT_SECRET=
JWT_REFRESH_SECRET=

# Primary admin bootstrap. The account is created once if its email does not exist.
ADMIN_EMAIL=admin@scp.dz
ADMIN_PASSWORD=
ADMIN_PHONE=0550000000

# Optional AI integration
GEMINI_API_KEY=

# Chargily Pay V2. Use test credentials only with CHARGILY_MODE=test.
# Keep the secret key in the workspace Secrets panel, never in this file.
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=
# Public HTTPS URLs reachable by Chargily (no trailing slash).
PUBLIC_BACKEND_URL=
# Chargily webhooks are delivered to PUBLIC_BACKEND_URL/api/v1/payments/webhook.

# Frontend (Vercel)
VITE_API_URL=https://your-backend.onrender.com
